# Turso Database Configuration
# Copy this file to .env and fill in your Turso credentials

# Get these values by running:
# turso db show ceo-dashboard --url
# turso db tokens create ceo-dashboard

TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-auth-token-here

# Leave these empty to use local SQLite instead
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# Optional: OpenAI API for Advanced AI Insights
# Get your API key from: https://platform.openai.com/api-keys
# Uncomment and fill in to enable GPT-4 powered insights
# OPENAI_API_KEY=sk-your-openai-api-key-here
